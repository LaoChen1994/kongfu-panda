{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bamboo Guardians",
  "version": "0.1.0",
  "identifier": "com.laochen1994.bamboo-guardians",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm exec vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "pnpm build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "竹林无双 · Bamboo Guardians",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
